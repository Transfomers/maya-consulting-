# Copier en .env et remplir. Ne jamais committer .env.

# ── React (dev) ──
PORT=3001
BROWSER=none
# URL de l'admin Flask (injectée au build React : CI=false npm run build)
REACT_APP_ADMIN_URL=https://admin.3mservice.shop/admin/dashboard

# ── Flask (admin, port 5002) ──
# Obligatoire en production : python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Vide = SQLite instance/3mservices.db
DATABASE_URL=
# Site public React
PUBLIC_SITE_URL=https://3mservice.shop
# URL publique de la WebApp Flask (liens dans les e-mails)
APP_BASE_URL=https://admin.3mservice.shop
# API Node vue depuis le navigateur de l'admin (chat)
NODE_API_URL=https://3mservice.shop/api
# Mot de passe du super admin créé au 1er lancement (base vide uniquement)
ADMIN_INITIAL_PASSWORD=

# ── E-mail (Flask-Mail) ──
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=contact@3mservice.shop
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=contact@3mservice.shop

# ── Node API (port 5001) ──
# Adresse interne de Flask vue par Node (Docker : nom du service, ex. http://flask:5002)
FLASK_INTERNAL_URL=http://127.0.0.1:5002
# Fichier JSON de l'API Node synchronisé par Flask (Docker : volume partagé)
EXPRESS_DB_JSON=
